---
import Container from "../layout/Container.astro";
import TopicLink from "./TopicLink.astro";
import {
  amonraSections,
  type AmonraSectionGroup,
} from "../../config/amonra-sections";

const groups: { id: AmonraSectionGroup; label: string }[] = [
  { id: "amonra", label: "Amonra" },
  { id: "autoconocimiento", label: "Autoconocimiento" },
  { id: "simbolismo", label: "Sabiduría simbólica" },
  { id: "practicas", label: "Prácticas" },
  { id: "bienestar", label: "Bienestar" },
];
---

<section
  class="border-b border-antique-gold-soft/40 bg-[var(--color-surface-warm)] py-12 lg:py-24"
  id="explorar"
  aria-labelledby="universo-amonra-title"
>
  <Container>
    <div class="border-b border-antique-gold-soft/35 pb-10">
      <p class="eyebrow text-antique-gold">Conocimiento y práctica</p>
      <h2
        class="mt-4 max-w-[16ch] font-editorial text-[clamp(2.7rem,5vw,4.8rem)] leading-none font-medium text-ivory"
        id="universo-amonra-title"
      >
        Caminos de conocimiento
      </h2>
      <p class="mt-6 max-w-[42rem] font-editorial text-xl leading-relaxed italic text-old-papyrus">
        Explora los temas agrupados según tu interés y propósito.
      </p>
    </div>

    <div class="mt-10 flex flex-col gap-12 lg:gap-16">
      {groups.map((group) => {
        const sectionsInGroup = amonraSections.filter(
          (s) => s.group === group.id,
        );

        if (sectionsInGroup.length === 0) return null;

        return (
          <div class="group-container">
            <h3 class="mb-6 font-interface text-[0.85rem] font-semibold uppercase tracking-[0.2em] text-antique-gold">
              {group.label}
            </h3>

            <ol class="grid list-none gap-4 p-0 md:grid-cols-2 lg:grid-cols-3">
              {sectionsInGroup.map((section) => (
                <li class="min-w-0">
                  <TopicLink section={section} />
                </li>
              ))}
            </ol>
          </div>
        );
      })}
    </div>
  </Container>
  <Container class="pb-10">
    <div class="flex flex-col items-start justify-between gap-5 border-t border-antique-gold-soft/35 pt-8 sm:flex-row sm:items-center">
      <div>
        <p class="font-editorial text-2xl text-ivory">
          ¿Quieres compartir una intención?
        </p>
        <p class="mt-2 max-w-[42rem] text-sm leading-relaxed text-ivory-muted">
          Puedes pedir una oración, dedicar una luz o enviarnos otra petición.
        </p>
      </div>
      <a
        href="/peticiones/"
        class="inline-flex min-h-11 items-center justify-center rounded-full border border-antique-gold-soft/60 px-6 font-interface text-sm font-semibold text-old-papyrus transition-colors hover:border-antique-gold hover:bg-night-raised focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-antique-gold"
      >
        Enviar una petición
      </a>
    </div>
  </Container>
</section>
