---
import Container from "../layout/Container.astro";
import {
  amonraSections,
  amonraSectionPath,
  type AmonraSectionGroup,
} from "../../config/amonra-sections";

const groups: { id: AmonraSectionGroup; label: string }[] = [
  { id: "amonra", label: "Amonra" },
  { id: "autoconocimiento", label: "Autoconocimiento" },
  { id: "simbolismo", label: "Sabiduría simbólica" },
  { id: "practicas", label: "Prácticas" },
  { id: "bienestar", label: "Bienestar" },
];
---

<section
  class="border-b border-antique-gold-soft/40 bg-[var(--color-surface-warm)] py-12 lg:py-24"
  id="caminos"
  aria-labelledby="universo-amonra-title"
>
  <Container>
    <div class="border-b border-antique-gold-soft/35 pb-10">
      <p class="eyebrow text-antique-gold">Conocimiento y práctica</p>
      <h2
        class="mt-4 max-w-[16ch] font-editorial text-[clamp(2.7rem,5vw,4.8rem)] leading-none font-medium text-ivory"
        id="universo-amonra-title"
      >
        Caminos de conocimiento
      </h2>
      <p class="mt-6 max-w-[42rem] font-editorial text-xl leading-relaxed italic text-old-papyrus">
        Explora los temas agrupados según tu interés y propósito.
      </p>
    </div>

    <div class="mt-10 flex flex-col gap-12 lg:gap-16">
      {groups.map((group) => {
        const sectionsInGroup = amonraSections.filter(
          (s) => s.group === group.id,
        );

        if (sectionsInGroup.length === 0) return null;

        return (
          <div class="group-container">
            <h3 class="mb-6 font-interface text-[0.85rem] font-semibold uppercase tracking-[0.2em] text-antique-gold">
              {group.label}
            </h3>

            <ol class="grid list-none gap-x-8 p-0 md:grid-cols-2 lg:grid-cols-3">
              {sectionsInGroup.map((section) => {
                const isPublished = section.status === "published";

                return (
                  <li class="border-b border-antique-gold-soft/35">
                    {isPublished ? (
                      <a
                        class="group grid h-full grid-cols-[minmax(0,1fr)_auto] items-center gap-4 px-3 py-4 text-ivory no-underline transition-colors hover:bg-night-raised focus-visible:outline-2 focus-visible:outline-offset-[-4px] focus-visible:outline-antique-gold md:py-6"
                        href={amonraSectionPath(section)}
                      >
                        <div>
                          <h4 class="font-editorial text-2xl font-medium text-ivory group-hover:text-old-papyrus">
                            {section.title}
                          </h4>
                          <p class="mt-1 pr-4 text-sm leading-relaxed text-ivory-muted">
                            {section.description}
                          </p>
                        </div>
                        <span
                          aria-hidden="true"
                          class="text-xl text-antique-gold"
                        >
                          →
                        </span>
                      </a>
                    ) : (
                      <div
                        class="grid h-full grid-cols-[minmax(0,1fr)_auto] items-center gap-4 px-3 py-4 md:py-6 opacity-70"
                        aria-disabled="true"
                      >
                        <div>
                          <h4 class="font-editorial text-2xl font-medium text-ivory-muted">
                            {section.title}
                          </h4>
                          <p class="mt-1 pr-4 text-sm leading-relaxed text-ivory-muted">
                            {section.description}
                          </p>
                        </div>
                        <span class="rounded-full border border-antique-gold-soft/50 px-3 py-1 font-interface text-[0.65rem] font-medium uppercase tracking-widest text-antique-gold-soft">
                          Preparación
                        </span>
                      </div>
                    )}
                  </li>
                );
              })}
            </ol>
          </div>
        );
      })}
    </div>
  </Container>
</section>
