---
import {
  amonraSectionPath,
  type AmonraSection,
} from "../../config/amonra-sections";
import "../../styles/topic-identities.css";

interface Props {
  section: AmonraSection;
  variant?: "menu" | "previous" | "next";
}

const { section, variant = "menu" } = Astro.props;
const isPublished = section.status === "published";
---

<a
  class:list={["topic-link", `topic-link--${variant}`]}
  data-topic-link={section.slug}
  data-topic-variant={variant}
  href={isPublished ? amonraSectionPath(section) : "/en-construccion/"}
>
  {variant === "menu" ? (
    <>
      <div class="topic-link-copy">
        <h4 class="topic-link-title">{section.title}</h4>
        <p class="topic-link-description">{section.description}</p>
      </div>
      {isPublished ? (
        <span class="topic-link-arrow" aria-hidden="true">
          →
        </span>
      ) : (
        <span class="topic-link-status">Preparación</span>
      )}
    </>
  ) : (
    <div class="topic-link-copy">
      <span class="topic-link-eyebrow">
        {variant === "previous" ? "Anterior" : "Siguiente"}
      </span>
      <span class="topic-link-title">
        {variant === "previous" ? `← ${section.title}` : `${section.title} →`}
      </span>
    </div>
  )}
</a>

<style>
  .topic-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    min-width: 0;
    min-height: 7.5rem;
    height: 100%;
    border: 1px solid color-mix(in srgb, var(--topic-detail) 65%, transparent);
    border-radius: var(--radius-medium);
    background-color: var(--topic-base);
    background-image:
      linear-gradient(
        120deg,
        var(--topic-veil-start),
        var(--topic-veil-end) 75%
      ),
      var(--topic-texture);
    background-repeat: no-repeat, repeat;
    background-position: center, center;
    background-size: auto, auto;
    padding: 1.25rem;
    color: var(--topic-hero-text);
    text-decoration: none;
    transition:
      border-color var(--transition-color),
      box-shadow var(--transition-color);
  }

  .topic-link:hover {
    border-color: var(--topic-hero-text);
    color: var(--topic-hero-text);
    box-shadow: inset 0 0 0 1px var(--topic-hero-text);
  }

  .topic-link:focus-visible {
    outline: 3px solid var(--topic-hero-text);
    outline-offset: 3px;
  }

  .topic-link-copy {
    min-width: 0;
  }

  .topic-link-title {
    display: block;
    margin: 0;
    color: inherit;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.2;
  }

  .topic-link:is(:hover, :focus-visible) .topic-link-title {
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }

  .topic-link-description {
    margin: 0.4rem 0 0;
    color: inherit;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .topic-link-arrow {
    font-size: 1.25rem;
  }

  .topic-link-status {
    border: 1px solid currentColor;
    border-radius: var(--radius-pill);
    padding: 0.25rem 0.5rem;
    font-size: 0.6875rem;
  }

  .topic-link-eyebrow {
    display: block;
    margin-bottom: 0.5rem;
    font-family: var(--font-ui);
    font-size: 0.8125rem;
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .topic-link--previous,
  .topic-link--next {
    display: block;
    padding: 1.5rem;
  }

  .topic-link--next {
    text-align: right;
  }

  @media (forced-colors: active) {
    .topic-link,
    .topic-link:hover {
      border-color: LinkText;
      background: Canvas;
      color: LinkText;
      box-shadow: none;
    }

    .topic-link:focus-visible {
      outline-color: Highlight;
    }
  }

  @media print {
    .topic-link {
      border-color: currentColor;
      background: none;
      color: var(--color-ink);
    }
  }
</style>
