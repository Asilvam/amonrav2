                    <span class="font-editorial text-sm font-semibold text-antique-gold-deep">
                      {seal.indigenousName}
                    </span>
                  </div>
                  <h5 class="mt-2 font-editorial text-lg font-bold text-paper-ink">
                    {seal.name}
                  </h5>
                  <p class="mt-2 text-xs leading-relaxed text-paper-muted">
                    {seal.description}
                  </p>
                  {seal.shadow && (
                    <div class="mt-3 border-t border-antique-gold-soft/20 pt-2 text-[0.75rem] text-amber-900/80">
                      <strong>Sombra:</strong> {seal.shadow}
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>
        </article>
      </section>
    </ContentTabs>
  </section>
</div>
