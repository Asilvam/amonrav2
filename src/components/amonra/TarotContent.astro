</div>

<script>
  document
    .querySelectorAll<HTMLElement>("[data-arcana-index]")
    .forEach((root) => {
      const search = root.querySelector<HTMLInputElement>(
        "[data-arcana-search]",
      );
      const count = root.querySelector<HTMLElement>("[data-arcana-count]");
      const links = Array.from(
        root.querySelectorAll<HTMLAnchorElement>("[data-arcana-link]"),
      );
      const cards = links
        .map((link) => document.getElementById(link.hash.slice(1)))
        .filter((card): card is HTMLElement => Boolean(card));

      if (!search || !count || cards.length !== links.length) return;

      const searchInput = search;
      const countElement = count;

      function normalize(value: string) {
        return value
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "")
          .toLowerCase()
          .trim();
      }

      function update() {
        const query = normalize(searchInput.value);
        let visible = 0;

        links.forEach((link, index) => {
          const name = normalize(link.dataset.arcanaName || "");
          const matches = !query || name.includes(query);
          link.hidden = !matches;
          cards[index].hidden = !matches;
          if (matches) visible += 1;
        });

        countElement.textContent = query
          ? `${visible} ${visible === 1 ? "arcano encontrado" : "arcanos encontrados"}`
          : "22 arcanos disponibles";
      }

      searchInput.addEventListener("input", update);
    });
</script>

