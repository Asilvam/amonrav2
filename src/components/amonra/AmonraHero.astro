---
import { Image } from "astro:assets";
import Container from "../layout/Container.astro";
import { amonraMessages } from "../../config/amonra-messages";
import papyrusTexture from "../../assets/amonra/papiro-jeroglificos.jpg";
import egyptianPortal from "../../assets/amonra/portal-egipcio.png";
---

<header
  class="amonra-home-hero relative isolate border-b border-[#e9b867] bg-[#eadb9b]"
  style={`background-image: url('${papyrusTexture.src}'); background-repeat: repeat;`}
>
  <Container
    size="wide"
    class="grid min-h-[36rem] [@media(orientation:landscape)_and_(max-height:31.25rem)]:min-h-0 items-center gap-12 py-16 lg:grid-cols-[minmax(0,0.9fr)_minmax(30rem,1.1fr)] lg:py-24"
  >
    <div class="relative z-10 max-w-[44rem]">
      <p class="eyebrow text-[#3a1400]">Red de Luz Interior · Amonra Chile</p>
      <h1 class="amonra-home-title mt-5 font-editorial text-[clamp(3.5rem,8vw,8rem)] leading-[0.88] font-medium tracking-[-0.06em] text-[#d60504] uppercase">
        Amonra
      </h1>
      <p class="mt-7 max-w-[24ch] font-editorial text-[clamp(1.45rem,3vw,2.7rem)] leading-tight font-medium text-[#3a1400]">
        {amonraMessages.lema}
      </p>
      <p class="mt-5 max-w-[40ch] font-editorial text-xl leading-relaxed text-[#3a1400]">
        {amonraMessages.principal}
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-5 font-interface text-sm">
        <a
          class="group flex min-h-[44px] min-w-[44px] items-center justify-center border border-[#3a1400] bg-[#534a2f] px-6 py-3.5 font-semibold text-[#eadb9b] no-underline shadow-[0_7px_18px_rgb(58_20_0/0.16)] transition-colors hover:bg-[#3a1400]"
          href="#explorar"
        >
          <span>Explorar Amonra</span>
        </a>
        <a
          class="flex min-h-[44px] min-w-[44px] items-center justify-center px-1 py-3 font-semibold text-[#3a1400] underline decoration-[#725124] underline-offset-8 hover:decoration-2"
          href="#proposito"
        >
          Nuestro propósito
        </a>
      </div>
    </div>

    <figure class="relative m-0">
      <Image
        src={egyptianPortal}
        alt="Portal ceremonial egipcio con columnas, figuras de Anubis y símbolos solares"
        widths={[640, 960, 1280, 1367]}
        sizes="(min-width: 1024px) 48vw, 100vw"
        loading="eager"
        class="max-h-[38rem] w-full object-contain drop-shadow-[0_22px_26px_rgb(78_45_13/0.24)]"
      />
    </figure>
  </Container>
</header>

<style>
  .amonra-home-title {
    text-shadow:
      -1px -1px 0 #eadb9b,
      0 -1px 0 #eadb9b,
      1px -1px 0 #eadb9b,
      -1px 0 0 #eadb9b,
      1px 0 0 #eadb9b,
      -1px 1px 0 #eadb9b,
      0 1px 0 #eadb9b,
      1px 1px 0 #eadb9b;
  }

  .amonra-home-hero a:focus-visible {
    outline: 3px solid #3a1400;
    outline-offset: 4px;
  }
</style>
