---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  label: string;
  slides: { src: ImageMetadata; alt: string }[];
}

const { label, slides } = Astro.props;
---

<amonra-image-carousel
  role="region"
  aria-roledescription="carrusel"
  aria-label={label}
  tabindex="0"
>
  <div class="carousel-stage">
    {slides.map((slide, index) => (
      <figure
        class="carousel-slide"
        role="group"
        aria-roledescription="imagen"
        aria-label={`${index + 1} de ${slides.length}`}
      >
        <Image
          src={slide.src}
          alt={slide.alt}
          widths={[480, 768, 1152]}
          sizes="(min-width: 640px) 36rem, 92vw"
          loading={index === 0 ? "eager" : "lazy"}
          class="carousel-image"
        />
      </figure>
    ))}
  </div>
  <div class="carousel-controls" hidden>
    <button type="button" data-carousel-play aria-label="Pausar carrusel">
      <span aria-hidden="true">Ⅱ</span>
    </button>
    <span class="carousel-status" aria-live="polite" aria-atomic="true">
      1 / {slides.length}
    </span>
  </div>
</amonra-image-carousel>

<script>
  class AmonraImageCarousel extends HTMLElement {
    private cleanup?: () => void;

    connectedCallback() {
      if (this.hasAttribute("data-ready")) return;
      const slides = Array.from(
        this.querySelectorAll<HTMLElement>(".carousel-slide"),
      );
      const controls = this.querySelector<HTMLElement>(".carousel-controls");
      const status = this.querySelector<HTMLElement>(".carousel-status");
      const stage = this.querySelector<HTMLElement>(".carousel-stage");
      const play = this.querySelector<HTMLButtonElement>(
        "[data-carousel-play]",
      );
      const playIcon = play?.querySelector("span");
      if (
        slides.length < 2 ||
        !controls ||
        !status ||
        !stage ||
        !play ||
        !playIcon
      )
        return;
      const events = new AbortController();
      const options = { signal: events.signal };
      const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      );
      let paused = reducedMotion.matches;
      let hovered = false;
      let focusPaused = false;
      let timer: number | undefined;
      let current = 0;

      const select = (index: number) => {
        current = (index + slides.length) % slides.length;
        slides.forEach((slide, i) => {
          slide.hidden = i !== current;
        });
        status.textContent = `${current + 1} / ${slides.length}`;
      };

      const clearTimer = () => {
        if (timer !== undefined) window.clearTimeout(timer);
        timer = undefined;
      };
      const syncAutoplay = () => {
        clearTimer();
        const running =
          !paused &&
          !hovered &&
          !focusPaused &&
          !document.hidden &&
          this.isConnected;
        play.setAttribute(
          "aria-label",
          paused ? "Reproducir carrusel" : "Pausar carrusel",
        );
        playIcon.textContent = paused ? "▶" : "Ⅱ";
        status.setAttribute("aria-live", running ? "off" : "polite");
        if (running)
          timer = window.setTimeout(() => {
            timer = undefined;
            select(current + 1);
            syncAutoplay();
          }, 6000);
      };
      const selectManually = (index: number) => {
        paused = true;
        syncAutoplay();
        select(index);
      };
      play.addEventListener(
        "click",
        () => {
          paused = !paused;
          focusPaused = false;
          syncAutoplay();
        },
        options,
      );
      this.addEventListener(
        "pointerenter",
        (event) => {
          if (event.pointerType !== "mouse") return;
          hovered = true;
          syncAutoplay();
        },
        options,
      );
      this.addEventListener(
        "pointerleave",
        (event) => {
          if (event.pointerType !== "mouse") return;
          hovered = false;
          syncAutoplay();
        },
        options,
      );
      this.addEventListener(
        "focusin",
        (event) => {
          focusPaused = event.target !== play;
          syncAutoplay();
        },
        options,
      );
      this.addEventListener(
        "focusout",
        (event) => {
          if (
            event.relatedTarget instanceof Node &&
            this.contains(event.relatedTarget)
          )
            return;
          focusPaused = false;
          syncAutoplay();
        },
        options,
      );
      document.addEventListener("visibilitychange", syncAutoplay, options);
      reducedMotion.addEventListener(
        "change",
        () => {
          if (reducedMotion.matches) paused = true;
          syncAutoplay();
        },
        options,
      );
      this.cleanup = () => {
        clearTimer();
        events.abort();
        this.removeAttribute("data-ready");
      };

      this.addEventListener(
        "keydown",
        (event) => {
          let next: number;
          switch (event.key) {
            case "ArrowLeft":
              next = current - 1;
              break;
            case "ArrowRight":
              next = current + 1;
              break;
            case "Home":
              next = 0;
              break;
            case "End":
              next = slides.length - 1;
              break;
            default:
              return;
          }
          event.preventDefault();
          selectManually(next);
        },
        options,
      );

      let start: { x: number; y: number; id: number } | undefined;
      stage.addEventListener(
        "pointerdown",
        (event) => {
          if (event.pointerType !== "touch" || !event.isPrimary) return;
          start = { x: event.clientX, y: event.clientY, id: event.pointerId };
          paused = true;
          syncAutoplay();
        },
        options,
      );
      stage.addEventListener(
        "pointerup",
        (event) => {
          if (!start || start.id !== event.pointerId) return;
          const dx = event.clientX - start.x;
          const dy = event.clientY - start.y;
          start = undefined;
          if (Math.abs(dx) >= 50 && Math.abs(dx) > Math.abs(dy) * 1.5)
            selectManually(current + (dx < 0 ? 1 : -1));
        },
        options,
      );
      stage.addEventListener(
        "pointercancel",
        () => {
          start = undefined;
        },
        options,
      );
      select(0);
      controls.hidden = false;
      this.setAttribute("data-ready", "");
      syncAutoplay();
    }

    disconnectedCallback() {
      this.cleanup?.();
      this.cleanup = undefined;
    }
  }

  if (!customElements.get("amonra-image-carousel"))
    customElements.define("amonra-image-carousel", AmonraImageCarousel);
</script>

<style>
  amonra-image-carousel {
    display: block;
    width: 100%;
    max-width: 36rem;
    min-width: 0;
    margin-inline: auto;
  }

  .carousel-stage {
    display: grid;
    gap: 1rem;
  }

  [data-ready] .carousel-stage {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid
      color-mix(in srgb, var(--topic-hero-text) 35%, transparent);
    background: #0b0704;
    box-shadow: 0 1rem 2rem rgb(0 0 0 / 25%);
    touch-action: pan-y pinch-zoom;
  }

  .carousel-slide {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 0;
    margin: 0;
  }

  .carousel-slide[hidden],
  .carousel-controls[hidden] {
    display: none;
  }

  .carousel-image {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  [data-ready] .carousel-image {
    height: 100%;
    max-height: 100%;
  }

  .carousel-controls {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  amonra-image-carousel:focus-visible,
  amonra-image-carousel:focus-within {
    outline: 2px solid var(--topic-hero-text);
    outline-offset: 4px;
  }
</style>
