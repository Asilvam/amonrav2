---
import AmonraLayout from "../../layouts/AmonraLayout.astro";
import Container from "../../components/layout/Container.astro";
---

<AmonraLayout
  title="Administrar peticiones"
  description="Panel privado para revisar y actualizar las peticiones recibidas por Amonra."
>
  <main class="min-h-[70vh] bg-paper py-12 text-paper-ink lg:py-16">
    <Container size="wide">
      <p class="eyebrow text-clay-red">Amonra · administración</p>
      <h1 class="mt-3 font-editorial text-4xl text-paper-ink">
        Peticiones recibidas
      </h1>
      <p class="mt-3 max-w-prose text-paper-muted">
        Panel privado para revisar solicitudes confirmadas y actualizar su
        estado.
      </p>

      <p
        id="admin-message"
        class="mt-6 text-sm text-paper-ink"
        role="status"
        aria-live="polite"
      ></p>

      <section
        id="admin-login"
        class="mt-8 max-w-xl rounded-2xl border border-antique-gold-soft/60 bg-[var(--color-parchment-soft)] p-6 shadow-sm sm:p-8"
      >
        <h2 class="font-editorial text-2xl">Acceso de administración</h2>
        <form id="admin-login-form" class="mt-5 space-y-4">
          <div>
            <label
              for="admin-password"
              class="mb-2 block text-sm font-semibold"
            >
              Contraseña de administración
            </label>
            <input
              id="admin-password"
              name="password"
              type="password"
              autocomplete="current-password"
              required
              maxlength="200"
              class="min-h-12 w-full rounded-lg border border-antique-gold-soft bg-paper px-4 py-3 text-paper-ink"
            />
          </div>
          <button
            type="submit"
            class="inline-flex min-h-11 items-center justify-center rounded-full bg-clay-red px-6 text-sm font-semibold text-white"
          >
            Iniciar sesión
          </button>
        </form>
      </section>

      <section id="admin-dashboard" class="mt-8" hidden>
        <div class="flex flex-wrap items-end justify-between gap-4 rounded-xl border border-antique-gold-soft/50 bg-[var(--color-parchment-soft)] p-4">
          <div>
            <label
              for="petition-filter"
              class="mb-2 block text-sm font-semibold"
            >
              Filtrar por estado
            </label>
            <select
              id="petition-filter"
              class="min-h-11 rounded-lg border border-antique-gold-soft bg-paper px-3 text-paper-ink"
            >
              <option value="all">Todas</option>
              <option value="pending_confirmation">
                Pendientes de confirmación
              </option>
              <option value="received">Recibidas</option>
              <option value="completed">Realizadas</option>
              <option value="cancelled">Anuladas</option>
            </select>
          </div>
          <div class="flex gap-3">
            <button
              id="refresh-petitions"
              type="button"
              class="min-h-11 rounded-full border border-antique-gold-soft px-5 text-sm font-semibold hover:bg-paper"
            >
              Actualizar
            </button>
            <button
              id="admin-logout"
              type="button"
              class="min-h-11 rounded-full bg-clay-ink px-5 text-sm font-semibold text-white hover:bg-clay-ink/90"
            >
              Cerrar sesión
            </button>
          </div>
        </div>
        <div id="petition-list" class="mt-6 grid gap-5"></div>
      </section>
    </Container>
  </main>

  <script>
    type Petition = {
      reference: string;
      kind: string;
      duration?: string;
      candleColor?: string;
      candleType?: string;
      message: string;
      name: string;
      phone?: string;
      email: string;
      share: boolean;
      status: "pending_confirmation" | "received" | "completed" | "cancelled";
      createdAt: string;
      updatedAt: string;
    };

    const loginSection = document.querySelector<HTMLElement>("#admin-login");
    const dashboard = document.querySelector<HTMLElement>("#admin-dashboard");
    const loginForm =
      document.querySelector<HTMLFormElement>("#admin-login-form");
    const message = document.querySelector<HTMLElement>("#admin-message");
    const filter =
      document.querySelector<HTMLSelectElement>("#petition-filter");
    const list = document.querySelector<HTMLElement>("#petition-list");
    const apiBase = (
      import.meta.env.PUBLIC_API_BASE_URL ||
      (import.meta.env.DEV ? "http://localhost:3500" : window.location.origin)
    ).replace(/[/]+$/, "");
    const labels: Record<Petition["status"], string> = {
      pending_confirmation: "Pendiente de confirmación",
      received: "Recibida",
      completed: "Realizada",
      cancelled: "Anulada",
    };

    async function api(path: string, init: RequestInit = {}) {
      const response = await fetch(`${apiBase}/api${path}`, {
        ...init,
        credentials: "include",
        headers: { "Content-Type": "application/json", ...init.headers },
      });
      const body = await response.json().catch(() => ({}));
      if (!response.ok) {
        const error = new Error(
          Array.isArray(body.message)
            ? body.message.join(" ")
            : body.message || "No se pudo completar la operación.",
        ) as Error & { status?: number };
        error.status = response.status;
        throw error;
      }
      return body;
    }

    function setMessage(text: string) {
      if (message) message.textContent = text;
    }

    function addText(
      parent: HTMLElement,
      tag: string,
      text: string,
      className = "",
    ) {
      const element = document.createElement(tag);
      element.textContent = text;
      if (className) element.className = className;
      parent.append(element);
      return element;
    }

    function renderPetition(petition: Petition) {
      const card = document.createElement("article");
      card.className =
        "rounded-2xl border border-antique-gold-soft/60 bg-[var(--color-parchment-soft)] p-5 shadow-sm sm:p-6";
      const heading = document.createElement("div");
      heading.className =
        "flex flex-wrap items-start justify-between gap-3 border-b border-antique-gold-soft/40 pb-4";
      addText(
        heading,
        "h2",
        `${petition.kind} · ${petition.reference}`,
        "font-editorial text-2xl text-paper-ink",
      );
      addText(
        heading,
        "span",
        labels[petition.status],
        "rounded-full bg-paper px-3 py-1 text-xs font-semibold text-paper-ink",
      );
      card.append(heading);
      addText(
        card,
        "p",
        `Recibida: ${new Date(petition.createdAt).toLocaleString("es-CL")}`,
        "mt-4 text-sm text-paper-muted",
      );
      addText(
        card,
        "p",
        `Nombre: ${petition.name || "Sin nombre registrado"} · Correo: ${petition.email}`,
        "mt-1 break-all text-sm text-paper-ink",
      );
      if (petition.phone)
        addText(
          card,
          "p",
          `WhatsApp o celular: ${petition.phone}`,
          "mt-1 text-sm text-paper-ink",
        );
      addText(
        card,
        "p",
        `Difusión comunitaria: ${petition.share ? "Autorizada" : "No autorizada"}`,
        "mt-1 text-sm text-paper-muted",
      );
      const details = [
        petition.duration && `Duración: ${petition.duration}`,
        petition.candleColor && `Color de vela: ${petition.candleColor}`,
        petition.candleType && `Tipo de encendido: ${petition.candleType}`,
      ].filter(Boolean);
      if (details.length)
        addText(
          card,
          "p",
          details.join(" · "),
          "mt-2 text-sm text-paper-muted",
        );
      addText(
        card,
        "p",
        petition.message,
        "mt-4 whitespace-pre-wrap break-words rounded-lg bg-paper p-4 text-sm leading-relaxed text-paper-ink",
      );

      if (petition.status === "pending_confirmation") {
        addText(
          card,
          "p",
          "No se puede administrar hasta que se confirme el correo.",
          "mt-4 text-sm font-semibold text-paper-muted",
        );
      } else {
        const controls = document.createElement("div");
        controls.className =
          "mt-5 flex flex-wrap items-end gap-3 border-t border-antique-gold-soft/40 pt-4";
        const label = document.createElement("label");
        label.className = "grid gap-1 text-sm font-semibold";
        label.textContent = "Cambiar estado";
        const select = document.createElement("select");
        select.className =
          "min-h-11 rounded-lg border border-antique-gold-soft bg-paper px-3 text-paper-ink";
        for (const value of ["received", "completed", "cancelled"] as const) {
          const option = document.createElement("option");
          option.value = value;
          option.textContent = labels[value];
          select.append(option);
        }
        select.value = petition.status;
        label.append(select);
        const save = document.createElement("button");
        save.type = "button";
        save.className =
          "min-h-11 rounded-full bg-clay-ink px-5 text-sm font-semibold text-white hover:bg-clay-ink/90";
        save.textContent = "Guardar estado";
        save.addEventListener("click", async () => {
          save.disabled = true;
          try {
            await api(
              `/admin/peticiones/${encodeURIComponent(petition.reference)}`,
              {
                method: "PATCH",
                body: JSON.stringify({ status: select.value }),
              },
            );
            setMessage(`Estado actualizado para ${petition.reference}.`);
            await loadPetitions();
          } catch (error) {
            setMessage(
              error instanceof Error
                ? error.message
                : "No pudimos actualizar el estado.",
            );
            if ((error as Error & { status?: number }).status === 401)
              showLogin();
          } finally {
            save.disabled = false;
          }
        });
        controls.append(label, save);
        card.append(controls);
      }
      const deleteButton = document.createElement("button");
      deleteButton.type = "button";
      deleteButton.className =
        "mt-4 min-h-10 rounded-full border border-clay-red px-4 text-sm font-semibold text-clay-red hover:bg-clay-red hover:text-white";
      deleteButton.textContent = "Eliminar definitivamente";
      deleteButton.addEventListener("click", async () => {
        const confirmed = window.confirm(
          `¿Eliminar para siempre la petición ${petition.reference}? Esta acción borra sus datos y no se puede deshacer.`,
        );
        if (!confirmed) return;
        deleteButton.disabled = true;
        try {
          await api(
            `/admin/peticiones/${encodeURIComponent(petition.reference)}`,
            { method: "DELETE" },
          );
          setMessage(`Petición ${petition.reference} eliminada definitivamente.`);
          await loadPetitions();
        } catch (error) {
          setMessage(
            error instanceof Error
              ? error.message
              : "No pudimos eliminar la petición.",
          );
          if ((error as Error & { status?: number }).status === 401)
            showLogin();
        } finally {
          deleteButton.disabled = false;
        }
      });
      card.append(deleteButton);
      return card;
    }

    async function loadPetitions() {
      if (!filter || !list) return;
      const body = await api(
        `/admin/peticiones?status=${encodeURIComponent(filter.value)}`,
      );
      list.replaceChildren();
      for (const petition of body.petitions as Petition[])
        list.append(renderPetition(petition));
      setMessage(
        body.petitions.length
          ? `Se muestran ${body.petitions.length} peticiones.`
          : "No hay peticiones para este filtro.",
      );
      if (loginSection) loginSection.hidden = true;
      if (dashboard) dashboard.hidden = false;
    }

    function showLogin() {
      if (loginSection) loginSection.hidden = false;
      if (dashboard) dashboard.hidden = true;
    }

    if (loginForm) {
      loginForm.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!loginForm.reportValidity()) return;
        const input = loginForm.querySelector<HTMLInputElement>(
          "input[name=password]",
        );
        const submit = loginForm.querySelector<HTMLButtonElement>(
          "button[type=submit]",
        );
        if (!input || !submit) return;
        submit.disabled = true;
        setMessage("Validando acceso…");
        try {
          await api("/admin/login", {
            method: "POST",
            body: JSON.stringify({ password: input.value }),
          });
          input.value = "";
          await loadPetitions();
        } catch (error) {
          setMessage(
            error instanceof Error
              ? error.message
              : "No pudimos iniciar sesión.",
          );
          showLogin();
        } finally {
          submit.disabled = false;
        }
      });
    }

    document
      .querySelector("#refresh-petitions")
      ?.addEventListener(
        "click",
        () => void loadPetitions().catch((error) => setMessage(error.message)),
      );
    filter?.addEventListener(
      "change",
      () => void loadPetitions().catch((error) => setMessage(error.message)),
    );
    document
      .querySelector("#admin-logout")
      ?.addEventListener("click", async () => {
        try {
          await api("/admin/logout", { method: "POST" });
        } catch {
          /* cerrar sesión visualmente también si la API no responde */
        }
        showLogin();
        setMessage("Sesión cerrada.");
      });

    void loadPetitions().catch((error) => {
      showLogin();
      if ((error as Error & { status?: number }).status !== 401)
        setMessage(error.message || "No pudimos conectar con el backend.");
    });
  </script>
</AmonraLayout>
