---
import AmonraHero from "../components/amonra/AmonraHero.astro";
import KnowledgePaths from "../components/amonra/KnowledgePaths.astro";
import AmonraPurpose from "../components/amonra/AmonraPurpose.astro";
import RelatedSites from "../components/amonra/RelatedSites.astro";
import Container from "../components/layout/Container.astro";
import { amonraMessages } from "../config/amonra-messages";
import AmonraLayout from "../layouts/AmonraLayout.astro";
import papyrusTexture from "../assets/amonra/papiro-jeroglificos.jpg";
---

<AmonraLayout
  title="Amonra"
  description={"Red de Luz Interior Amonra Chile. " + amonraMessages.principal}
  image="/amonra-og.png"
>
  <article class="overflow-clip">
    <AmonraHero />

    <KnowledgePaths />

    <RelatedSites />

    <section
      class="border-b border-[#e9b867] bg-[#eadb9b] py-20 text-paper-ink lg:py-28"
      id="proposito"
      aria-label="Propósito"
      style={`--purpose-texture: url('${papyrusTexture.src}'); background-image: var(--purpose-texture); background-repeat: repeat;`}
    >
      <Container>
        <AmonraPurpose />
      </Container>
    </section>
  </article>
</AmonraLayout>
