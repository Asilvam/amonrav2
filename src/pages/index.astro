---
import AmonraHero from "../components/amonra/AmonraHero.astro";
import ExploreByIntent from "../components/amonra/ExploreByIntent";
import KnowledgePaths from "../components/amonra/KnowledgePaths.astro";
import FeaturedContent from "../components/amonra/FeaturedContent.astro";
import AmonraPurpose from "../components/amonra/AmonraPurpose.astro";
import Container from "../components/layout/Container.astro";
import { amonraMessages } from "../config/amonra-messages";
import AmonraLayout from "../layouts/AmonraLayout.astro";
---

<AmonraLayout
  title="Amonra"
  description={"Red de Luz Interior Amonra Chile. " + amonraMessages.principal}
  image="/amonra-og.png"
>
  <article class="overflow-clip">
    <AmonraHero />

    <ExploreByIntent client:load />

    <KnowledgePaths />

    <FeaturedContent />

    <section
      class="border-b border-antique-gold-soft/50 bg-paper py-20 text-paper-ink lg:py-28"
      id="proposito"
      aria-label="Propósito"
    >
      <Container>
        <AmonraPurpose />
      </Container>
    </section>
  </article>
</AmonraLayout>
