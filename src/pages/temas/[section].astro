---
import { Image } from "astro:assets";
import AmuletsContent from "../../components/amonra/AmuletsContent.astro";
import AstrologyContent from "../../components/amonra/AstrologyContent.astro";
import CandlesContent from "../../components/amonra/CandlesContent.astro";
import FoundationContent from "../../components/amonra/FoundationContent.astro";
import HistoryContent from "../../components/amonra/HistoryContent.astro";
import IncenseContent from "../../components/amonra/IncenseContent.astro";
import GemsContent from "../../components/amonra/GemsContent.astro";
import DreamsContent from "../../components/amonra/DreamsContent.astro";
import TarotContent from "../../components/amonra/TarotContent.astro";
import RunesContent from "../../components/amonra/RunesContent.astro";
import OraclesContent from "../../components/amonra/OraclesContent.astro";
import Breadcrumbs from "../../components/common/Breadcrumbs.astro";
import Container from "../../components/layout/Container.astro";
import { amonraMessages } from "../../config/amonra-messages";
import {
  amonraSectionPath,
  amonraSections,
  type AmonraSection,
} from "../../config/amonra-sections";
import AmonraLayout from "../../layouts/AmonraLayout.astro";
import amuletsHero from "../../assets/amonra/amuletos-hero.jpg";
import astrologyHero from "../../assets/amonra/astrologia-hero.jpg";
import candlesHero from "../../assets/amonra/velas-hero.png";
import foundationHero from "../../assets/amonra/fundacion-hero.png";
import historyHero from "../../assets/amonra/historia-hero.jpg";
import incenseHero from "../../assets/amonra/inciensos-hero.jpg";
import gemsHero from "../../assets/amonra/gemas-hero.jpg";
import dreamsHero from "../../assets/amonra/suenos-hero.jpg";
import tarotHero from "../../assets/amonra/tarot-hero.jpg";
import runesHero from "../../assets/amonra/runas-hero.jpg";
import oraclesHero from "../../assets/amonra/oraculos-hero.jpg";

interface Props {
  section: AmonraSection;
}

export function getStaticPaths() {
  return amonraSections.map((section) => ({
    params: { section: section.slug },
    props: { section },
  }));
}

const { section } = Astro.props;
const hasCompactHero = [
  "fundacion",
  "historia",
  "amuletos",
  "astrologia",
  "velas",
  "inciensos",
  "gemas",
  "suenos",
  "tarot",
  "runas",
  "oraculos",
].includes(section.slug);
const currentIndex = amonraSections.findIndex(
  (candidate) => candidate.slug === section.slug,
);
const previous =
  currentIndex > 0 ? amonraSections[currentIndex - 1] : undefined;
const next =
  currentIndex < amonraSections.length - 1
    ? amonraSections[currentIndex + 1]
    : undefined;
---

<AmonraLayout
  title={section.title}
  description={`${section.description} Red de Luz Interior Amonra Chile.`}
>
  <article>
    <div class="border-b border-antique-gold-soft/35 bg-night">
      <Container size="wide" class="py-1">
        <Breadcrumbs
          items={[{ label: "Inicio", href: "/" }, { label: section.title }]}
        />
      </Container>
    </div>

    <header class="border-b border-antique-gold-soft/45 bg-[linear-gradient(120deg,var(--color-legacy-violet-deep),var(--color-surface-warm)_62%)]">
      <Container
        class={
          hasCompactHero
            ? "grid items-center gap-8 py-8 lg:grid-cols-[minmax(18rem,0.7fr)_minmax(30rem,1.3fr)] lg:py-10"
            : "py-20 lg:py-28"
        }
      >
        <div>
          <p class="eyebrow text-antique-gold">
            Red de Luz Interior Amonra Chile
          </p>
          <h1 class="mt-5 max-w-[13ch] font-editorial text-[clamp(2.6rem,7vw,7rem)] leading-[0.92] font-medium tracking-[-0.045em] text-ivory">
            {section.title}
          </h1>
          {section.slug === "fundacion" && (
            <p class="mt-5 max-w-[24ch] font-editorial text-[clamp(1.25rem,2vw,1.7rem)] leading-snug italic text-old-papyrus">
              {amonraMessages.fundamento} Al servicio de quienes más lo
              necesitan.
            </p>
          )}
          {section.slug === "historia" && (
            <p class="mt-5 max-w-[24ch] font-editorial text-[clamp(1.25rem,2vw,1.7rem)] leading-snug italic text-old-papyrus">
              Raíces simbólicas de Amon y Ra en la tradición espiritual egipcia.
            </p>
          )}
          {section.slug === "amuletos" && (
            <p class="mt-5 max-w-[24ch] font-editorial text-[clamp(1.25rem,2vw,1.7rem)] leading-snug italic text-old-papyrus">
              Diferencias y uso tradicional de amuletos y talismanes.
            </p>
          )}
          {section.slug === "astrologia" && (
            <p class="mt-5 max-w-[24ch] font-editorial text-[clamp(1.25rem,2vw,1.7rem)] leading-snug italic text-old-papyrus">
              Una mirada a los astros, sus movimientos y sus influencias.
            </p>
          )}
          {section.slug === "velas" && (
            <p class="mt-5 max-w-[24ch] font-editorial text-[clamp(1.25rem,2vw,1.7rem)] leading-snug italic text-old-papyrus">
              Luz, colores y devoción tradicional en la práctica espiritual.
            </p>
          )}
          {section.slug === "inciensos" && (
            <p class="mt-5 max-w-[24ch] font-editorial text-[clamp(1.25rem,2vw,1.7rem)] leading-snug italic text-old-papyrus">
              Aromas sagrados, correspondencias elementales y purificación.
            </p>
          )}
          {section.slug === "gemas" && (
            <p class="mt-5 max-w-[24ch] font-editorial text-[clamp(1.25rem,2vw,1.7rem)] leading-snug italic text-old-papyrus">
              Cristales, gemoterapia y armonización energética tradicional.
            </p>
          )}
          {section.slug === "suenos" && (
            <p class="mt-5 max-w-[24ch] font-editorial text-[clamp(1.25rem,2vw,1.7rem)] leading-snug italic text-old-papyrus">
              Imágenes, arquetipos y despertar consciente en el mundo onírico.
            </p>
          )}
          {section.slug === "tarot" && (
            <p class="mt-5 max-w-[24ch] font-editorial text-[clamp(1.25rem,2vw,1.7rem)] leading-snug italic text-old-papyrus">
              Los 22 Arcanos Mayores, tradiciones egipcia y gitana, y métodos
              clásicos de lectura.
            </p>
          )}
          {section.slug === "runas" && (
            <p class="mt-5 max-w-[24ch] font-editorial text-[clamp(1.25rem,2vw,1.7rem)] leading-snug italic text-old-papyrus">
              El Futhark Sagrado de 25 caracteres, los tres Aettir y métodos
              clásicos de lectura nórdica.
            </p>
          )}
          {section.slug === "oraculos" && (
            <p class="mt-5 max-w-[24ch] font-editorial text-[clamp(1.25rem,2vw,1.7rem)] leading-snug italic text-old-papyrus">
              El Templo de Delfos, el I Ching milenario y los métodos
              tradicionales de consulta oracular.
            </p>
          )}
        </div>

        {section.slug === "fundacion" && (
          <figure class="m-0">
            <Image
              src={foundationHero}
              alt="Pirámides de Egipto custodiadas por Anubis y una figura egipcia bajo un cielo estrellado"
              widths={[560, 760, 960]}
              sizes="(min-width: 1024px) 58vw, 100vw"
              loading="eager"
              class="max-h-[20rem] w-full object-contain drop-shadow-2xl"
            />
          </figure>
        )}

        {section.slug === "historia" && (
          <figure class="m-0">
            <Image
              src={historyHero}
              alt="Representación simbólica de las raíces de la tradición egipcia y el origen de Amonra"
              widths={[420, 640, 960]}
              sizes="(min-width: 1024px) 42vw, 88vw"
              loading="eager"
              class="mx-auto max-h-[20rem] w-full max-w-[18rem] object-contain drop-shadow-2xl"
            />
          </figure>
        )}

        {section.slug === "amuletos" && (
          <figure class="m-0">
            <Image
              src={amuletsHero}
              alt="Composición de amuletos y talismanes de la tradición egipcia"
              widths={[560, 860, 1200]}
              sizes="(min-width: 1024px) 58vw, 100vw"
              loading="eager"
              class="mx-auto max-h-[20rem] w-full max-w-[18rem] object-contain drop-shadow-2xl"
            />
          </figure>
        )}

        {section.slug === "astrologia" && (
          <figure class="m-0">
            <Image
              src={astrologyHero}
              alt="Representación renacentista de la esfera celeste"
              widths={[400, 640, 800]}
              sizes="(min-width: 1024px) 42vw, 88vw"
              loading="eager"
              class="mx-auto max-h-[20rem] w-full max-w-[18rem] object-contain drop-shadow-2xl"
            />
          </figure>
        )}

        {section.slug === "velas" && (
          <figure class="m-0">
            <Image
              src={candlesHero}
              alt="Composición ceremonial de velas de la tradición de Amonra"
              widths={[380, 560, 760]}
              sizes="(min-width: 1024px) 42vw, 88vw"
              loading="eager"
              class="mx-auto max-h-[20rem] w-full max-w-[18rem] object-contain drop-shadow-2xl"
            />
          </figure>
        )}

        {section.slug === "inciensos" && (
          <figure class="m-0">
            <Image
              src={incenseHero}
              alt="Inciensos rituales y fragancias sagradas de la tradición de Amonra"
              widths={[380, 560, 640]}
              sizes="(min-width: 1024px) 42vw, 88vw"
              loading="eager"
              class="mx-auto max-h-[20rem] w-full max-w-[18rem] rounded-xl object-contain drop-shadow-2xl"
            />
          </figure>
        )}

        {section.slug === "gemas" && (
          <figure class="m-0">
            <Image
              src={gemsHero}
              alt="Composición de gemas y cristales de la tradición de Amonra"
              widths={[380, 560, 800]}
              sizes="(min-width: 1024px) 42vw, 88vw"
              loading="eager"
              class="mx-auto max-h-[20rem] w-full max-w-[18rem] rounded-xl object-contain drop-shadow-2xl"
            />
          </figure>
        )}

        {section.slug === "suenos" && (
          <figure class="m-0">
            <Image
              src={dreamsHero}
              alt="Figura en reposo bajo la noche estrellada y el farol de la conciencia onírica"
              widths={[380, 560, 700]}
              sizes="(min-width: 1024px) 42vw, 88vw"
              loading="eager"
              class="mx-auto max-h-[20rem] w-full max-w-[20rem] rounded-xl object-contain drop-shadow-2xl"
            />
          </figure>
        )}

        {section.slug === "tarot" && (
          <figure class="m-0">
            <Image
              src={tarotHero}
              alt="Lectura ceremonial del Tarot ante el pebetero y las cartas arcanas"
              widths={[380, 520, 600]}
              sizes="(min-width: 1024px) 42vw, 88vw"
              loading="eager"
              class="mx-auto max-h-[20rem] w-full max-w-[18rem] rounded-xl object-contain drop-shadow-2xl"
            />
          </figure>
        )}

        {section.slug === "runas" && (
          <figure class="m-0">
            <Image
              src={runesHero}
              alt="Runas vikingas sagradas talladas en madera sobre tela ceremonial"
              widths={[380, 520, 700]}
              sizes="(min-width: 1024px) 42vw, 88vw"
              loading="eager"
              class="mx-auto max-h-[20rem] w-full max-w-[18rem] rounded-xl object-contain drop-shadow-2xl"
            />
          </figure>
        )}

        {section.slug === "oraculos" && (
          <figure class="m-0">
            <Image
              src={oraclesHero}
              alt="Pitia de Delfos sobre el trípode délfico en el santuario de Apolo"
              widths={[380, 560, 800]}
              sizes="(min-width: 1024px) 42vw, 88vw"
              loading="eager"
              class="mx-auto max-h-[20rem] w-full max-w-[18rem] rounded-xl object-contain drop-shadow-2xl"
            />
          </figure>
        )}
      </Container>
    </header>

    {section.slug === "fundacion" && (
      <section class="border-b border-antique-gold-soft/45 bg-paper py-20 text-paper-ink lg:py-24">
        <Container>
          <FoundationContent />
        </Container>
      </section>
    )}

    {section.slug === "historia" && (
      <section class="border-b border-antique-gold-soft/45 bg-paper py-20 text-paper-ink lg:py-24">
        <Container>
          <HistoryContent />
        </Container>
      </section>
    )}

    {section.slug === "amuletos" && (
      <section class="border-b border-antique-gold-soft/45 bg-paper py-20 text-paper-ink lg:py-24">
        <Container>
          <AmuletsContent />
        </Container>
      </section>
    )}

    {section.slug === "astrologia" && (
      <section class="border-b border-antique-gold-soft/45 bg-paper py-20 text-paper-ink lg:py-24">
        <Container>
          <AstrologyContent />
        </Container>
      </section>
    )}

    {section.slug === "velas" && (
      <section class="border-b border-antique-gold-soft/45 bg-paper py-20 text-paper-ink lg:py-24">
        <Container>
          <CandlesContent />
        </Container>
      </section>
    )}

    {section.slug === "inciensos" && (
      <section class="border-b border-antique-gold-soft/45 bg-paper py-20 text-paper-ink lg:py-24">
        <Container>
          <IncenseContent />
        </Container>
      </section>
    )}

    {section.slug === "gemas" && (
      <section class="border-b border-antique-gold-soft/45 bg-paper py-20 text-paper-ink lg:py-24">
        <Container>
          <GemsContent />
        </Container>
      </section>
    )}

    {section.slug === "suenos" && (
      <section class="border-b border-antique-gold-soft/45 bg-paper py-20 text-paper-ink lg:py-24">
        <Container>
          <DreamsContent />
        </Container>
      </section>
    )}

    {section.slug === "tarot" && (
      <section class="border-b border-antique-gold-soft/45 bg-paper py-20 text-paper-ink lg:py-24">
        <Container>
          <TarotContent />
        </Container>
      </section>
    )}

    {section.slug === "runas" && (
      <section class="border-b border-antique-gold-soft/45 bg-paper py-20 text-paper-ink lg:py-24">
        <Container>
          <RunesContent />
        </Container>
      </section>
    )}

    {section.slug === "oraculos" && (
      <section class="border-b border-antique-gold-soft/45 bg-paper py-20 text-paper-ink lg:py-24">
        <Container>
          <OraclesContent />
        </Container>
      </section>
    )}

    <nav
      class="border-b border-antique-gold-soft/35 bg-night-soft"
      aria-label="Continuar por los temas de Amonra"
    >
      <Container class="grid gap-px bg-antique-gold-soft/30 p-px md:grid-cols-2">
        {previous ? (
          <a
            class="group bg-night px-6 py-6 text-ivory no-underline hover:bg-night-raised"
            href={amonraSectionPath(previous)}
          >
            <span class="eyebrow text-antique-gold">Anterior</span>
            <span class="mt-2 block font-editorial text-2xl">
              ← {previous.title}
            </span>
          </a>
        ) : (
          <a
            class="group bg-night px-6 py-6 text-ivory no-underline hover:bg-night-raised"
            href="/"
          >
            <span class="eyebrow text-antique-gold">Índice</span>
            <span class="mt-2 block font-editorial text-2xl">← Amonra</span>
          </a>
        )}
        {next ? (
          <a
            class="group bg-night px-6 py-6 text-right text-ivory no-underline hover:bg-night-raised"
            href={amonraSectionPath(next)}
          >
            <span class="eyebrow text-antique-gold">Siguiente</span>
            <span class="mt-2 block font-editorial text-2xl">
              {next.title} →
            </span>
          </a>
        ) : (
          <a
            class="group bg-night px-6 py-6 text-right text-ivory no-underline hover:bg-night-raised"
            href="/"
          >
            <span class="eyebrow text-antique-gold">Índice</span>
            <span class="mt-2 block font-editorial text-2xl">Amonra →</span>
          </a>
        )}
      </Container>
    </nav>
  </article>
</AmonraLayout>
