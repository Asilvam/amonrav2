---
import AmonraLayout from "../../layouts/AmonraLayout.astro";
import Container from "../../components/layout/Container.astro";
---

<AmonraLayout
  title="Consultar estado de petición"
  description="Consulta el estado de una petición enviada a Amonra."
>
  <main class="min-h-[65vh] bg-paper py-16 text-paper-ink lg:py-24">
    <Container size="reading">
      <section class="rounded-2xl border border-antique-gold-soft/60 bg-[var(--color-parchment-soft)] p-7 shadow-sm sm:p-10">
        <p class="eyebrow text-clay-red">Amonra · seguimiento</p>
        <h1 class="mt-3 font-editorial text-4xl text-paper-ink">
          Consulta tu petición
        </h1>
        <p class="mt-4 max-w-prose leading-relaxed text-paper-muted">
          Escribe la referencia y el código de seguimiento de 10 caracteres que
          recibiste por correo. También puedes usar una clave anterior más
          larga.
        </p>

        <form id="petition-status-form" class="mt-8 space-y-5">
          <div>
            <label
              for="status-reference"
              class="mb-2 block text-sm font-semibold"
            >
              Referencia
            </label>
            <input
              id="status-reference"
              name="reference"
              required
              pattern="AM-[A-Fa-f0-9]{12}"
              maxlength="15"
              placeholder="AM-0123456789AB"
              autocomplete="off"
              class="min-h-12 w-full rounded-lg border border-antique-gold-soft bg-[var(--color-parchment-subtle)] px-4 py-3 text-paper-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-clay-red"
            />
          </div>
          <div>
            <label for="status-code" class="mb-2 block text-sm font-semibold">
              Código de seguimiento
            </label>
            <input
              id="status-code"
              name="trackingToken"
              type="text"
              required
              minlength="10"
              maxlength="60"
              pattern="[A-Za-z0-9_-]+"
              placeholder="AB3K7M9Q2X"
              autocomplete="off"
              autocapitalize="characters"
              class="min-h-12 w-full rounded-lg border border-antique-gold-soft bg-[var(--color-parchment-subtle)] px-4 py-3 font-mono tracking-wider text-paper-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-clay-red"
            />
          </div>
          <button
            id="status-submit"
            type="submit"
            class="inline-flex min-h-12 items-center justify-center rounded-full bg-clay-red px-7 font-interface text-sm font-semibold text-white transition-colors hover:bg-clay-red/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-clay-red"
          >
            Consultar estado
          </button>
        </form>

        <section
          id="status-result"
          class="mt-6 rounded-lg border border-antique-gold-soft/60 bg-[var(--color-parchment-subtle)] p-5"
          role="status"
          aria-live="polite"
          hidden
        ></section>
        <p class="mt-6 text-sm text-paper-muted">
          <a class="underline underline-offset-4" href="/peticiones/">
            Volver a peticiones
          </a>
        </p>
      </section>
    </Container>
  </main>

  <script>
    const form = document.querySelector<HTMLFormElement>(
      "#petition-status-form",
    );
    const submit = document.querySelector<HTMLButtonElement>("#status-submit");
    const result = document.querySelector<HTMLElement>("#status-result");
    const apiBase = (
      import.meta.env.PUBLIC_API_BASE_URL ||
      (import.meta.env.DEV ? "http://localhost:3500" : window.location.origin)
    ).replace(/\/+$/u, "");
    const statusLabels: Record<string, string> = {
      pending_confirmation: "Pendiente de confirmar el correo",
      received: "Recibida",
      accepted: "Aceptada",
      in_progress: "En proceso",
      completed: "Realizada",
      cancelled: "Anulada",
    };

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!form.reportValidity() || !submit || !result) return;

      const values = new FormData(form);
      submit.disabled = true;
      submit.textContent = "Consultando…";
      result.hidden = false;
      result.textContent = "Estamos buscando tu petición…";

      try {
        const response = await fetch(`${apiBase}/api/peticiones/estado`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            reference: String(values.get("reference") || "")
              .trim()
              .toUpperCase(),
            trackingToken: String(values.get("trackingToken") || "").trim(),
          }),
        });
        const body = await response.json();
        if (!response.ok) {
          throw new Error(
            response.status === 404
              ? "No encontramos una petición con esos datos. Revisa la referencia y el código."
              : Array.isArray(body.message)
                ? body.message.join(" ")
                : body.message ||
                  "No pudimos consultar el estado. Inténtalo más tarde.",
          );
        }

        const heading = document.createElement("h2");
        heading.className = "font-editorial text-2xl text-paper-ink";
        heading.textContent = `Estado: ${statusLabels[body.status] || body.status}`;
        const reference = document.createElement("p");
        reference.className = "mt-2 text-sm text-paper-muted";
        reference.textContent = `Referencia: ${body.reference}`;
        result.replaceChildren(heading, reference);
      } catch (error) {
        result.textContent =
          error instanceof Error
            ? error.message
            : "No pudimos conectar con el servicio. Inténtalo más tarde.";
      } finally {
        submit.disabled = false;
        submit.textContent = "Consultar estado";
      }
    });
  </script>
</AmonraLayout>
