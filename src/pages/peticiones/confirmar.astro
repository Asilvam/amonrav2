---
import AmonraLayout from "../../layouts/AmonraLayout.astro";
import Container from "../../components/layout/Container.astro";
---

<AmonraLayout
  title="Confirmar petición"
  description="Confirma el correo asociado a tu petición en Amonra."
>
  <main class="min-h-[65vh] bg-paper py-16 text-paper-ink lg:py-24">
    <Container size="reading">
      <section class="rounded-2xl border border-antique-gold-soft/60 bg-[var(--color-parchment-soft)] p-7 shadow-sm sm:p-10">
        <p class="eyebrow text-clay-red">Amonra · confirmación de correo</p>
        <h1
          id="confirmation-title"
          class="mt-3 font-editorial text-4xl text-paper-ink"
        >
          Confirma tu petición
        </h1>
        <p
          id="confirmation-description"
          class="mt-4 max-w-prose leading-relaxed text-paper-muted"
        >
          Al confirmar, verificamos que tienes acceso al correo indicado. El
          enlace es de un solo uso y vence en 24 horas.
        </p>
        <p
          id="confirmation-message"
          class="mt-6 text-sm leading-relaxed text-paper-ink"
          role="status"
          aria-live="polite"
        >
          Pulsa el botón para validar tu correo y registrar la petición.
        </p>
        <button
          id="confirm-petition"
          type="button"
          class="mt-6 inline-flex min-h-12 items-center justify-center rounded-full bg-clay-red px-7 font-interface text-sm font-semibold text-white transition-colors hover:bg-clay-red/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-clay-red"
        >
          Confirmar mi correo
        </button>
        <form
          id="resend-form"
          class="mt-8 space-y-4 border-t border-antique-gold-soft/50 pt-6"
          hidden
        >
          <h2 class="font-editorial text-2xl text-paper-ink">
            ¿El enlace venció?
          </h2>
          <p class="text-sm leading-relaxed text-paper-muted">
            Solicita otro con la referencia y la clave privada que recibiste en
            el correo.
          </p>
          <div>
            <label
              for="resend-reference"
              class="mb-1 block text-sm font-semibold"
            >
              Referencia
            </label>
            <input
              id="resend-reference"
              name="reference"
              required
              pattern="AM-[A-F0-9]{12}"
              maxlength="15"
              placeholder="AM-0123456789AB"
              class="min-h-11 w-full rounded-lg border border-antique-gold-soft bg-paper px-3 py-2 text-paper-ink"
            />
          </div>
          <div>
            <label for="resend-email" class="mb-1 block text-sm font-semibold">
              Correo de la petición
            </label>
            <input
              id="resend-email"
              name="email"
              required
              type="email"
              maxlength="254"
              autocomplete="email"
              class="min-h-11 w-full rounded-lg border border-antique-gold-soft bg-paper px-3 py-2 text-paper-ink"
            />
          </div>
          <div>
            <label
              for="resend-tracking-token"
              class="mb-1 block text-sm font-semibold"
            >
              Código de seguimiento
            </label>
            <input
              id="resend-tracking-token"
              name="trackingToken"
              required
              type="password"
              minlength="10"
              maxlength="60"
              autocomplete="off"
              placeholder="AB3K7M9Q2X"
              class="min-h-11 w-full rounded-lg border border-antique-gold-soft bg-paper px-3 py-2 text-paper-ink"
            />
          </div>
          <button
            type="submit"
            class="inline-flex min-h-11 items-center justify-center rounded-full bg-clay-ink px-6 text-sm font-semibold text-white hover:bg-clay-ink/90"
          >
            Enviar otro enlace
          </button>
        </form>
        <p class="mt-6 text-sm text-paper-muted">
          <a class="underline underline-offset-4" href="/peticiones/">
            Volver a peticiones
          </a>
        </p>
      </section>
    </Container>
  </main>

  <script>
    const button =
      document.querySelector<HTMLButtonElement>("#confirm-petition");
    const title = document.querySelector<HTMLHeadingElement>(
      "#confirmation-title",
    );
    const description = document.querySelector<HTMLElement>(
      "#confirmation-description",
    );
    const message = document.querySelector<HTMLElement>(
      "#confirmation-message",
    );
    const token = new URLSearchParams(window.location.search).get("token");
    const resendForm = document.querySelector<HTMLFormElement>("#resend-form");
    const apiBase = (
      import.meta.env.PUBLIC_API_BASE_URL ||
      (import.meta.env.DEV ? "http://localhost:3500" : window.location.origin)
    ).replace(/\/+$/, "");

    if (button && message && resendForm) {
      if (!token) {
        message.textContent =
          "El enlace no contiene un token válido. Solicita un nuevo correo desde la página de peticiones.";
        button.hidden = true;
        resendForm.hidden = false;
      }

      button.addEventListener("click", async () => {
        if (!token) return;
        button.disabled = true;
        button.textContent = "Validando…";
        message.textContent = "Estamos validando tu enlace…";
        try {
          const response = await fetch(`${apiBase}/api/peticiones/confirmar`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ token }),
          });
          const result = await response.json();
          if (!response.ok) {
            const errorMessage = Array.isArray(result.message)
              ? result.message.join(" ")
              : result.message;
            if (response.status === 400) {
              button.hidden = true;
              resendForm.hidden = false;
            }
            throw new Error(errorMessage || "No pudimos confirmar el enlace.");
          }
          if (title) title.textContent = "¡Petición confirmada!";
          if (description) {
            description.textContent =
              "Tu correo quedó confirmado y la petición ya fue recibida por Amonra.";
          }
          message.textContent = `Estado: recibida · Referencia: ${result.reference}`;
          document.title = "Petición confirmada | Amonra";
          button.hidden = true;
          resendForm.hidden = true;
          window.history.replaceState(
            {},
            document.title,
            window.location.pathname,
          );
        } catch (error) {
          message.textContent =
            error instanceof Error
              ? error.message
              : "No pudimos validar el enlace. Vuelve a intentarlo.";
          if (!button.hidden) {
            button.disabled = false;
            button.textContent = "Intentar de nuevo";
          }
        }
      });

      resendForm.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (!resendForm.reportValidity()) return;
        const submit = resendForm.querySelector<HTMLButtonElement>(
          "button[type=submit]",
        );
        if (!submit) return;
        submit.disabled = true;
        submit.textContent = "Enviando…";
        message.textContent = "Estamos comprobando los datos de seguimiento…";
        const values = new FormData(resendForm);
        try {
          const response = await fetch(`${apiBase}/api/peticiones/reenviar`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              reference: String(values.get("reference") || "").trim(),
              email: String(values.get("email") || "").trim(),
              trackingToken: String(values.get("trackingToken") || "").trim(),
            }),
          });
          const result = await response.json();
          if (!response.ok)
            throw new Error(
              result.message || "No pudimos solicitar otro enlace.",
            );
          message.textContent = `${result.message} Si los datos coinciden, el nuevo enlace llegará a tu correo.`;
          resendForm.reset();
          window.history.replaceState(
            {},
            document.title,
            window.location.pathname,
          );
        } catch (error) {
          message.textContent =
            error instanceof Error
              ? error.message
              : "No pudimos conectar con el servicio.";
        } finally {
          submit.disabled = false;
          submit.textContent = "Enviar otro enlace";
        }
      });
    }
  </script>
</AmonraLayout>
