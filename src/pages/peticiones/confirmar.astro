---
import AmonraLayout from "../../layouts/AmonraLayout.astro";
import Container from "../../components/layout/Container.astro";
---

<AmonraLayout
  title="Confirmar petición"
  description="Confirma el correo asociado a tu petición en Amonra."
>
  <main class="min-h-[65vh] bg-paper py-16 text-paper-ink lg:py-24">
    <Container size="reading">
      <section class="rounded-2xl border border-antique-gold-soft/60 bg-[var(--color-parchment-soft)] p-7 shadow-sm sm:p-10">
        <p id="confirmation-eyebrow" class="eyebrow text-clay-red">
          Amonra · confirmación de correo
        </p>
        <h1
          id="confirmation-title"
          class="mt-3 font-editorial text-4xl text-paper-ink"
        >
          Validando tu petición…
        </h1>
        <p
          id="confirmation-description"
          class="mt-4 max-w-prose leading-relaxed text-paper-muted"
        >
          Estamos verificando tu correo y registrando la petición.
        </p>
        <p
          id="confirmation-message"
          class="mt-6 text-sm leading-relaxed text-paper-ink"
          role="status"
          aria-live="polite"
        >
          Espera un momento mientras validamos el enlace.
        </p>
        <section
          id="confirmation-status"
          class="mt-6 rounded-xl border border-antique-gold-soft/60 bg-paper p-5"
          aria-live="polite"
          hidden
        >
          <p class="eyebrow text-clay-red">Estado de la petición</p>
          <p
            id="confirmation-status-value"
            class="mt-2 font-editorial text-2xl font-semibold text-paper-ink"
          ></p>
        </section>
        <button
          id="confirm-petition"
          type="button"
          class="mt-6 inline-flex min-h-12 items-center justify-center rounded-full bg-clay-red px-7 font-interface text-sm font-semibold text-white transition-colors hover:bg-clay-red/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-clay-red"
        >
          Reintentar validación
        </button>
        <p class="mt-6 text-sm text-paper-muted">
          <a
            id="confirmation-back-link"
            class="underline underline-offset-4"
            href="/"
          >
            Volver al inicio
          </a>
        </p>
      </section>
    </Container>
  </main>

  <script>
    const button =
      document.querySelector<HTMLButtonElement>("#confirm-petition");
    const title = document.querySelector<HTMLHeadingElement>(
      "#confirmation-title",
    );
    const eyebrow = document.querySelector<HTMLElement>(
      "#confirmation-eyebrow",
    );
    const description = document.querySelector<HTMLElement>(
      "#confirmation-description",
    );
    const message = document.querySelector<HTMLElement>(
      "#confirmation-message",
    );
    const statusPanel = document.querySelector<HTMLElement>(
      "#confirmation-status",
    );
    const statusValue = document.querySelector<HTMLElement>(
      "#confirmation-status-value",
    );
    const backLink = document.querySelector<HTMLAnchorElement>(
      "#confirmation-back-link",
    );
    const token = new URLSearchParams(window.location.search).get("token");
    const apiBase = (
      import.meta.env.PUBLIC_API_BASE_URL ||
      (import.meta.env.DEV ? "http://localhost:3500" : window.location.origin)
    ).replace(/\/+$/, "");

    if (button && message) {
      if (!token) {
        if (title) title.textContent = "Enlace de confirmación incompleto";
        message.textContent =
          "Abre el enlace completo desde el correo. Si ya venció, puedes crear una nueva petición.";
        if (backLink) {
          backLink.href = "/peticiones/";
          backLink.textContent = "Volver a peticiones";
        }
        button.hidden = true;
      } else {
        button.hidden = true;
      }

      const confirmPetition = async () => {
        if (!token) return;
        let invalidLink = false;
        button.disabled = true;
        message.textContent = "Estamos validando tu enlace…";
        try {
          const response = await fetch(`${apiBase}/api/peticiones/confirmar`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ token }),
          });
          const result = await response.json();
          if (!response.ok) {
            const errorMessage = Array.isArray(result.message)
              ? result.message.join(" ")
              : result.message;
            if (response.status === 400) {
              invalidLink = true;
              if (title) title.textContent = "El enlace ya no está disponible";
              if (backLink) {
                backLink.href = "/peticiones/";
                backLink.textContent = "Volver a peticiones";
              }
              button.hidden = true;
            }
            throw new Error(errorMessage || "No pudimos confirmar el enlace.");
          }
          if (title) title.textContent = "¡Petición validada!";
          if (eyebrow) eyebrow.textContent = "Amonra · correo verificado";
          if (description) {
            description.textContent =
              "Tu correo quedó confirmado. La petición está registrada y puede comenzar el proceso.";
          }
          message.hidden = true;
          if (statusPanel && statusValue) {
            const statusLabels: Record<string, string> = {
              received: "Recibida",
              accepted: "Aceptada",
              in_progress: "En proceso",
              completed: "Realizada",
              cancelled: "Anulada",
            };
            statusValue.textContent =
              statusLabels[result.status] || "Recibida";
            statusPanel.hidden = false;
          }
          document.title = "Petición validada | Amonra";
          button.hidden = true;
          window.history.replaceState(
            {},
            document.title,
            window.location.pathname,
          );
        } catch (error) {
          message.textContent =
            error instanceof Error
              ? error.message
              : "No pudimos validar el enlace. Vuelve a intentarlo.";
          if (invalidLink) {
            button.hidden = true;
          } else {
            button.hidden = false;
            button.disabled = false;
            button.textContent = "Reintentar validación";
          }
        }
      };

      button.addEventListener("click", confirmPetition);
      if (token) void confirmPetition();
    }
  </script>
</AmonraLayout>
